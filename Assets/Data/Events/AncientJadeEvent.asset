  m_Script: {fileID: 11500000, guid: 4a5bd9d1e332a4848b3b546b59091506, type: 3}
  m_Name: AncientJadeEvent
  m_EditorClassIdentifier: Assembly-CSharp::EventData
  title: "\u8D22\u6C14\u51B2\u5929\u7684\u53E4\u7389"
  body: "\u591C\u8272\u5DF2\u6DF1\uFF0C\u4F60\u6B63\u51C6\u5907\u5173\u95E8\u3002\n\n\u4E00\u4E2A\u62AB\u7740\u6597\u7BF7\u7684\u7537\u4EBA\u5FFD\u7136\u8D70\u8FDB\u94FA\u4E2D\u3002\n\n\u4ED6\u6CA1\u6709\u5BD2\u6684\uFF0C\u53EA\u4ECE\u6000\u91CC\u53D6\u51FA\u4E00\u5757\u6697\u7EFF\u8272\u53E4\u7389\uFF0C\u653E\u5728\u67DC\u53F0\u4E0A\u3002\n\n\u201C\u4E94\u5341\u4E24\u3002\u201D\n\n\u201C\u73B0\u5728\u7ED9\u94B1\uFF0C\u5B83\u5C31\u662F\u4F60\u7684\u3002\u201D\n\n\u4F60\u8FD8\u6CA1\u78B0\u5230\u90A3\u5757\u7389\uFF0C\u80F8\u53E3\u5C31\u83AB\u540D\u4E00\u7D27\u3002\n\n\u90A3\u79CD\u611F\u89C9\u4F60\u5F88\u719F\u6089\u3002\n\n<b>\u8D22\u6C14\u3002</b>\n\n\u800C\u4E14\uFF0C\u6BD4\u4F60\u8FD9\u4E9B\u5E74\u89C1\u8FC7\u7684\u4EFB\u4F55\u4E1C\u897F\u90FD\u8981\u5F3A\u3002\n\n\u7537\u4EBA\u8865\u4E86\u4E00\u53E5\uFF1A\n\n\u201C\u522B\u95EE\u5B83\u4ECE\u54EA\u6765\u3002\u201D"
  options:
  - optionText: "\u82B150\u4E24\u4E70\u4E0B\u53E4\u7389"
    resultText: "\u4F60\u6CA1\u6709\u518D\u95EE\u3002\n\n\u4E94\u5341\u4E24\u94F6\u5B50\u843D\u5728\u67DC\u53F0\u4E0A\uFF0C\u90A3\u4EBA\u6293\u8D77\u94B1\u4FBF\u6D88\u5931\u5728\u591C\u8272\u91CC\u3002\n\n\u53E4\u7389\u843D\u5165\u4F60\u624B\u4E2D\u7684\u4E00\u523B\uFF0C\u4F60\u7B2C\u4E00\u6B21\u6E05\u6670\u5730\u611F\u89C9\u5230\u4E00\u79CD\u8FD1\u4E4E\u672C\u80FD\u7684\u51B2\u52A8\u2014\u2014\n\n<b>\u7559\u4E0B\u5B83\u3002</b>\n\n\u65E0\u8BBA\u53D1\u751F\u4EC0\u4E48\uFF0C\u90FD\u4E0D\u8981\u8BA9\u5B83\u79BB\u5F00\u3002"
    moneyChange: -50
    healthChange: 0
    reputationChange: 0
    greedChange: 10
    ancientJadeOutcome: 1
  - optionText: "\u82B110\u4E24\u6258\u4EBA\u67E5\u4E00\u67E5"
    resultText: "\u4F60\u538B\u4F4F\u5FC3\u91CC\u7684\u51B2\u52A8\uFF0C\u6CA1\u6709\u7ACB\u523B\u4F38\u624B\u3002\n\n\u201C\u660E\u65E5\u518D\u6765\u3002\u201D\n\n\u7537\u4EBA\u660E\u663E\u4E0D\u60A6\u3002\n\n\u4F46\u4F60\u5DF2\u7ECF\u51B3\u5B9A\uFF0C\u5148\u5F04\u6E05\u695A\u8FD9\u4EF6\u4E1C\u897F\u5230\u5E95\u662F\u4EC0\u4E48\u3002\n\n\u505A\u751F\u610F\u53EF\u4EE5\u8D4C\u3002\n\n<b>\u4F46\u81F3\u5C11\u5E94\u8BE5\u77E5\u9053\u81EA\u5DF1\u5728\u8D4C\u4EC0\u4E48\u3002</b>"
    moneyChange: -10
    healthChange: 0
    reputationChange: 1
    greedChange: 2
    ancientJadeOutcome: 2
  - optionText: "\u62D2\u7EDD\u8FD9\u7B14\u4EA4\u6613"
    resultText: "\u4F60\u76EF\u7740\u53E4\u7389\u770B\u4E86\u5F88\u4E45\u3002\n\n\u6700\u7EC8\uFF0C\u4F60\u628A\u624B\u4ECE\u67DC\u53F0\u4E0A\u6536\u4E86\u56DE\u6765\u3002\n\n\u201C\u4E1C\u897F\u592A\u597D\uFF0C\u6211\u4E70\u4E0D\u8D77\u3002\u201D\n\n\u7537\u4EBA\u51B7\u7B11\u4E86\u4E00\u58F0\uFF0C\u628A\u53E4\u7389\u91CD\u65B0\u6536\u5165\u6000\u4E2D\u3002\n\n\u95E8\u5173\u4E0A\u7684\u77AC\u95F4\uFF0C\u4F60\u7B2C\u4E00\u6B21\u611F\u53D7\u5230\u4E00\u79CD\u5947\u602A\u7684\u7A7A\u6D1E\u3002\n\n<b>\u4EFF\u4F5B\u6709\u4EC0\u4E48\u539F\u672C\u5C5E\u4E8E\u4F60\u7684\u4E1C\u897F\uFF0C\u88AB\u4EBA\u5E26\u8D70\u4E86\u3002</b>"
    moneyChange: 0
    healthChange: 0
    reputationChange: 2
    greedChange: -2
    ancientJadeOutcome: 3
